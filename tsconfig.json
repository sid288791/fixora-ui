{
  "extends": "@backstage/cli/config/tsconfig.json",
  "include": [
    "packages/*/src",
    "packages/*/config.d.ts",
    "plugins/*/src",
    "plugins/*/config.d.ts",
    "plugins/*/dev",
    "plugins/*/migrations"
  ],
  "exclude": ["node_modules"],
  "compilerOptions": {
    "outDir": "dist-types",
    "rootDir": ".",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@internal/plugin-fixora-dashboard": [
        "plugins/fixora-dashboard/src/index.ts"
      ],
      "@internal/plugin-fixora-onboarding": [
        "plugins/fixora-onboarding/src/index.ts"
      ]
    }
  }
}
